# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# Shared secret between the Cloudflare Worker and the app (openssl rand -hex 32)
MC_HMAC_SECRET=
# Worker URL for sending (reply/compose/forward), printed by `wrangler deploy`
MC_WORKER_URL=https://mailcatcher.<your subdomain>.workers.dev
# Optional: manage destination addresses from the app (token with Email Routing Addresses: Edit)
MC_CF_API_TOKEN=
MC_CF_ACCOUNT_ID=
# Public URL of this app = the tunnel's public hostname; the Worker delivers mail here
MC_PUBLIC_URL=https://<app hostname>
# Domain that receives mail via Email Routing catch-all
MC_DOMAIN=<your catch all domain>
# Password for the first "admin" user (first start only). Empty = a random one is
# printed in the log and must be changed at first login.
MC_ADMIN_PASSWORD=
# Delete messages older than this many days (0 = keep forever)
MC_RETENTION_DAYS=30
# Host user/group that owns ./data (run `id` on the host; create ./data first)
MC_UID=1000
MC_GID=1000
