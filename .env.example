# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
# Shared secret between the Cloudflare Worker and the app (openssl rand -hex 32)
MC_HMAC_SECRET=
# Domain that receives mail via Email Routing catch-all
MC_DOMAIN=<your catch all domain>
# Password for the first "admin" user (first start only). Empty = a random one is
# printed in the log and must be changed at first login.
MC_ADMIN_PASSWORD=
